# syntax=docker/dockerfile:1
#
# Build vllm v0.28.0 with free-threaded Python 3.14t using uv (CPU backend).
#
# Usage:
#   docker build -f Dockerfile.cpu -t vllm-freethreaded-cpu .
#   docker run -e PYTHON_GIL=0 vllm-freethreaded-cpu python -c "import vllm; print(vllm.__version__)"
#
# CPU ISA build arguments (cross-compilation only; native builds detect the
# host).  On x86, v0.28.0 builds three kernel variants (_C, _C_AVX512,
# _C_AVX2) and picks one at import time; see cmake/cpu_extension.cmake.
#
#   VLLM_CPU_X86=0       force the x86 kernel set when cross-compiling
#   VLLM_CPU_ARM_BF16=0  ARM BF16
#   VLLM_CPU_ARM_I8MM=0  ARM I8MM
#   VLLM_CPU_RVV_BF16=0  RISC-V vector BF16
#
# Written with help from Claude Opus 4.6.

# ---------------------------------------------------------------------------
# build — System packages, uv, Python, Rust, source builds
# ---------------------------------------------------------------------------
FROM ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

ARG TARGETARCH

# g++ >= 12.3 is a hard requirement of the x86 CPU backend
# (cmake/cpu_extension.cmake); ubuntu:24.04 ships 13.3.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update && apt-get install -y --no-install-recommends \
        git \
        ccache \
        numactl \
        libnuma-dev \
        g++ \
        curl \
        pkg-config \
        libssl-dev \
        protobuf-compiler \
        ca-certificates \
        cmake \
        ninja-build \
        zlib1g-dev \
        libzstd-dev \
        libncurses-dev \
        libxml2-dev

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.10.2 /uv /uvx /bin/

WORKDIR /app

# Create a free-threaded Python 3.14t venv
RUN uv venv /app/.venv --python cpython-3.14t
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:${PATH}"
ENV UV_LINK_MODE=copy

# Set git identity (needed for git am in clone-repos.py)
RUN git config --global user.email "build@docker.example.com" \
    && git config --global user.name "Docker Build"

ARG MAX_JOBS="4"

# CPU ISA build arguments (see header).
ARG VLLM_CPU_X86=0
ARG VLLM_CPU_ARM_BF16=0
ARG VLLM_CPU_ARM_I8MM=0
ARG VLLM_CPU_RVV_BF16=0

# Propagate ISA args to env for the vllm build
ENV VLLM_CPU_X86=${VLLM_CPU_X86}
ENV VLLM_CPU_ARM_BF16=${VLLM_CPU_ARM_BF16}
ENV VLLM_CPU_ARM_I8MM=${VLLM_CPU_ARM_I8MM}
ENV VLLM_CPU_RVV_BF16=${VLLM_CPU_RVV_BF16}

# Install Rust (cached across builds; not stored in image layers)
ENV CARGO_HOME=/root/.cargo
ENV RUSTUP_HOME=/root/.rustup
ENV PATH=/root/.cargo/bin:$PATH

RUN --mount=type=cache,target=/root/.rustup \
    --mount=type=cache,target=/root/.cargo \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal

# Selects the +cpu torch wheels; PyPI's torch would pull in the CUDA stack.
ARG TORCH_INDEX_SUFFIX="cpu"
ENV TORCH_INDEX_URL="https://download.pytorch.org/whl/${TORCH_INDEX_SUFFIX}"

ADD requirements/torch.txt /tmp/r
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.rustup \
    --mount=type=cache,target=/root/.cargo \
    UV_HTTP_TIMEOUT=200 \
    uv pip install -r /tmp/r \
        --extra-index-url "${TORCH_INDEX_URL}"

ADD requirements/common.txt /tmp/r
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.rustup \
    --mount=type=cache,target=/root/.cargo \
    UV_HTTP_TIMEOUT=200 uv pip install -r /tmp/r

# From vllm's requirements/cpu.txt (x86_64 only).  Pure-data wheel that drops
# libiomp5.so into the venv; inert unless LD_PRELOADed (see run_docker_cpu.sh).
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$TARGETARCH" = "amd64" ]; then \
        UV_HTTP_TIMEOUT=200 uv pip install intel-openmp==2024.2.1 ; \
    fi

# Validate ISA flags — prevent mixing x86/ARM flags
RUN if [ "$TARGETARCH" = "arm64" ] && [ "$VLLM_CPU_X86" != "0" ]; then \
        echo "ERROR: Cannot set VLLM_CPU_X86 when building for ARM64"; \
        exit 1; \
    fi && \
    if [ "$TARGETARCH" = "amd64" ] && \
       { [ "$VLLM_CPU_ARM_BF16" != "0" ] || [ "$VLLM_CPU_ARM_I8MM" != "0" ]; }; then \
        echo "ERROR: Cannot use ARM-specific ISA flags when building for x86_64"; \
        exit 1; \
    fi

# Copy clone infrastructure
COPY clone-repos.py git-repos.txt fixup-env.py ./
COPY patches/ patches/

# Triton is optional on CPU: the CPU backend's kernels are the C++ extensions
# built below, and triton_kernels.cmake is only included for CUDA/HIP.
ARG BUILD_TRITON=0

# Clone required repos (triton only when enabled)
RUN python clone-repos.py \
        --repo vllm \
        --repo tokenizers \
        $( [ "$BUILD_TRITON" = "1" ] && echo --repo triton )

# Optionally build Triton from source (editable). Builds GPU-free; it downloads
# a prebuilt LLVM during the build.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.ccache \
    if [ "$BUILD_TRITON" = "1" ]; then \
        export CCACHE_DIR=/root/.ccache MAX_JOBS="${MAX_JOBS}" \
               CC="ccache gcc" CXX="ccache g++" && \
        uv pip install -r third_party/triton/python/requirements.txt && \
        uv pip install -e third_party/triton -v --no-build-isolation --no-deps ; \
    fi

# Build tokenizers from source.  PyPI ships no wheel installable under
# free-threaded 3.14t.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.rustup \
    --mount=type=cache,target=/root/.cargo \
    uv pip install third_party/tokenizers/bindings/python -v \
        --no-build-isolation --no-deps

# Build vllm from source (editable -- source tree needed at runtime).  This
# step fetches and statically links oneDNN, and on x86 compiles the kernels
# three times (AMX / AVX512 / AVX2).
#
# Use CMAKE_*_COMPILER_LAUNCHER rather than CC="ccache gcc": oneDNN has an
# assembler source and CMake's ASM language takes only the first word of CC,
# so ccache gets invoked without gcc.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.ccache \
    CCACHE_DIR=/root/.ccache \
    VLLM_TARGET_DEVICE=cpu \
    MAX_JOBS="${MAX_JOBS}" \
    CMAKE_C_COMPILER_LAUNCHER=ccache \
    CMAKE_CXX_COMPILER_LAUNCHER=ccache \
    uv pip install -e third_party/vllm -v \
        --no-build-isolation --no-deps

# Fail here rather than at inference time if an extension is missing or has
# the wrong ABI tag.  All three x86 variants must exist: import_kernels()
# picks one per host, and a missing one is a silent fallback to no kernels.
# The stable ABI is disabled under free-threading, so abi3 means a bad build.
RUN set -eu; \
    cd /app/third_party/vllm/vllm; \
    if [ "$TARGETARCH" = "amd64" ] || [ "$VLLM_CPU_X86" != "0" ]; then \
        want="_C _C_AVX512 _C_AVX2 spinloop fs_io_C"; \
    else \
        want="_C spinloop fs_io_C"; \
    fi; \
    for m in $want; do \
        so="$(echo ${m}.cpython-314t-*.so)"; \
        [ -f "$so" ] || { echo "ERROR: ${m} extension missing (got '$so')"; \
                          ls -1 *.so; exit 1; }; \
        echo "EXT $so"; \
    done; \
    if ls *abi3*.so >/dev/null 2>&1; then \
        echo "ERROR: abi3 extensions built under free-threading:"; \
        ls -1 *abi3*.so; exit 1; \
    fi

# Apply post-install fixups to the built environment
RUN python fixup-env.py

# staging — Assemble only the files needed at runtime
RUN set -eux \
    # --- Create staging directory structure --- \
    && mkdir -p /staging/root/.local/share/uv \
                /staging/app \
    # --- Python venv + the uv-managed Python it symlinks into --- \
    && mv /app/.venv /staging/app/.venv \
    && mv /root/.local/share/uv/python /staging/root/.local/share/uv/python \
    # --- vllm source (editable install needs this at runtime) --- \
    && mkdir -p /staging/app/third_party \
    && mv /app/third_party/vllm /staging/app/third_party/vllm \
    && rm -rf /staging/app/third_party/vllm/vllm/.deps \
    # --- triton source (editable install; present only when BUILD_TRITON=1) --- \
    && if [ -d /app/third_party/triton ]; then \
         mv /app/third_party/triton /staging/app/third_party/triton; \
       fi

# ---------------------------------------------------------------------------
# runtime — Production image
# ---------------------------------------------------------------------------
FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Runtime system dependencies.  libnuma1 and libgomp1 are linked by _C;
# libtcmalloc-minimal4 is optional (upstream LD_PRELOADs it), see
# run_docker_cpu.sh.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update && apt-get install -y --no-install-recommends \
        vim-tiny \
        less \
        git \
        numactl \
        libgomp1 \
        libtcmalloc-minimal4 \
        ca-certificates \
        gcc \
        g++ \
        libc6-dev

# All runtime files in a single COPY layer
COPY --from=build /staging/ /

# Refresh the dynamic linker cache
RUN ldconfig

# Environment
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:${PATH}"
ENV PYTHON_GIL=0

WORKDIR /app
