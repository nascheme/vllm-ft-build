# syntax=docker/dockerfile:1
#
# Build vllm v0.15.1 with free-threaded Python 3.14t using uv.
#
# Usage:
#   docker build --build-arg TORCH_CUDA_ARCH_LIST="7.5" -t vllm-freethreaded .
#   docker run --gpus all -e PYTHON_GIL=0 vllm-freethreaded \
#       python -c "import vllm; print(vllm.__version__)"
#
# The build uses a multi-stage approach. Final stage produces a minimal image
# based on nvidia/cuda base.  Build with --squash for a single-layer image.
#
# Written with help from Claude Opus 4.6.

# ---------------------------------------------------------------------------
# build — System packages, uv, Python, Rust, source builds
# ---------------------------------------------------------------------------
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

# CUDA env vars
ENV CUDA_HOME=/usr/local/cuda
ENV CUDA_PATH=/usr/local/cuda

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update && apt-get install -y --no-install-recommends \
        git \
        ccache \
        numactl \
        libnuma-dev \
        g++ \
        curl \
        pkg-config \
        libssl-dev \
        protobuf-compiler \
        ca-certificates \
        cmake \
        ninja-build \
        zlib1g-dev \
        libzstd-dev \
        libncurses-dev \
        libxml2-dev

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.10.2 /uv /uvx /bin/

# Create a free-threaded Python 3.14t venv
RUN uv venv /app/.venv --python cpython-3.14t
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:${PATH}"
ENV UV_LINK_MODE=copy

# Set git identity (needed for git am in clone-repos.py)
RUN git config --global user.email "build@docker.example.com" \
    && git config --global user.name "Docker Build"

WORKDIR /app

# Install Rust (cached across builds; not stored in image layers)
ENV CARGO_HOME=/root/.cargo
ENV RUSTUP_HOME=/root/.rustup
ENV PATH=/root/.cargo/bin:$PATH

RUN --mount=type=cache,target=/root/.rustup \
    --mount=type=cache,target=/root/.cargo \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal

ARG TORCH_INDEX_SUFFIX="cu128"
ENV TORCH_INDEX_URL="https://download.pytorch.org/whl/${TORCH_INDEX_SUFFIX}"

ADD requirements/torch.txt /tmp/r
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.rustup \
    --mount=type=cache,target=/root/.cargo \
    UV_HTTP_TIMEOUT=200 \
    uv pip install -r /tmp/r \
        --extra-index-url "${TORCH_INDEX_URL}"

ADD requirements/common.txt /tmp/r
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.rustup \
    --mount=type=cache,target=/root/.cargo \
    UV_HTTP_TIMEOUT=200 uv pip install -r /tmp/r

# Copy clone infrastructure
COPY clone-repos.py git-repos.txt fixup-env.py ./
COPY patches/ patches/

# Triton is optional: enable with --build-arg BUILD_TRITON=1 (see build_docker.py
# --triton). When enabled it is cloned at the pinned commit and the
# free-threading patches in patches/triton/ are applied by clone-repos.py.
ARG BUILD_TRITON=0

# Clone all required repos (triton only when enabled)
RUN python clone-repos.py \
        --repo vllm \
        --repo flash-attention \
        --repo tokenizers \
        --repo tiktoken \
        $( [ "$BUILD_TRITON" = "1" ] && echo --repo triton )

ARG TORCH_CUDA_ARCH_LIST="7.5"
ARG MAX_JOBS="4"
ARG NVCC_THREADS="4"

# Optionally build Triton from source (editable — source tree needed at
# runtime). Triton JITs at runtime so it needs no CUDA arch list; it downloads
# a prebuilt LLVM during the build.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.ccache \
    if [ "$BUILD_TRITON" = "1" ]; then \
        export CCACHE_DIR=/root/.ccache MAX_JOBS="${MAX_JOBS}" \
               CC="ccache gcc" CXX="ccache g++" && \
        uv pip install -r third_party/triton/python/requirements.txt && \
        uv pip install -e third_party/triton -v --no-build-isolation --no-deps ; \
    fi

# Build tokenizers from source.  PyPI ships no wheel installable under
# free-threaded 3.14t.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.rustup \
    --mount=type=cache,target=/root/.cargo \
    uv pip install third_party/tokenizers/bindings/python -v \
        --no-build-isolation --no-deps

# Build tiktoken from source.  PyPI ships no wheel installable under
# free-threaded 3.14t.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.rustup \
    --mount=type=cache,target=/root/.cargo \
    uv pip install third_party/tiktoken -v \
        --no-build-isolation --no-deps

# Build vllm from source (editable — source tree needed at runtime)
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.ccache \
    CCACHE_DIR=/root/.ccache \
    VLLM_FLASH_ATTN_SRC_DIR=/app/third_party/flash-attention \
    TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST}" \
    VLLM_TARGET_DEVICE=cuda \
    MAX_JOBS="${MAX_JOBS}" \
    NVCC_THREADS="${NVCC_THREADS}" \
    CC="ccache gcc" \
    CXX="ccache g++" \
    CMAKE_CUDA_COMPILER_LAUNCHER=ccache \
    uv pip install -e third_party/vllm -v \
        --no-build-isolation --no-deps

# Apply post-install fixups to the built environment.
RUN python fixup-env.py

# staging — Assemble only the files needed at runtime
RUN set -eux \
    # --- Create staging directory structure --- \
    && mkdir -p /staging/usr/lib/x86_64-linux-gnu \
                /staging/root/.local/share/uv \
                /staging/app \
    # --- CUDA-related system shared libs (cublas, cudnn, nccl, …) --- \
    # The base nvidia/cuda image already provides /usr/local/cuda-12.8 \
    # runtime libs; we only need the extra libraries installed via apt \
    # in the devel image (cublas, cudnn, nccl, etc.). \
    && for lib in libcublas libcublasLt libcufft libcurand libcusolver \
                  libcusparse libnccl libnvrtc libnvJitLink libcudnn \
                  libnvToolsExt; do \
         for f in /usr/lib/x86_64-linux-gnu/${lib}*; do \
           [ -e "$f" ] && cp -al "$f" /staging/usr/lib/x86_64-linux-gnu/ || true; \
         done; \
       done \
    # --- Python venv + the uv-managed Python it symlinks into --- \
    && mv /app/.venv /staging/app/.venv \
    && mv /root/.local/share/uv/python /staging/root/.local/share/uv/python \
    # --- vllm source (editable install needs this at runtime) --- \
    && mkdir -p /staging/app/third_party \
    && mv /app/third_party/vllm /staging/app/third_party/vllm \
    && rm -rf /staging/app/third_party/vllm/vllm/.deps \
    # --- triton source (editable install; present only when BUILD_TRITON=1) --- \
    && if [ -d /app/third_party/triton ]; then \
         mv /app/third_party/triton /staging/app/third_party/triton; \
       fi

# ---------------------------------------------------------------------------
# runtime — Minimal production image
# ---------------------------------------------------------------------------
FROM nvidia/cuda:12.8.1-base-ubuntu24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Runtime system dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update && apt-get install -y --no-install-recommends \
        vim-tiny \
        less \
        git \
        numactl \
        libgomp1 \
        ca-certificates \
        gcc \
        libc6-dev

# All runtime files in a single COPY layer
COPY --from=build /staging/ /

# Refresh the dynamic linker cache
RUN ldconfig

# Environment
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:${PATH}"
ENV PYTHON_GIL=0

WORKDIR /app
