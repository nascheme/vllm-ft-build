From f89b7769cc5f1850a318b168037bb6b15e6384f9 Mon Sep 17 00:00:00 2001
From: Neil Schemenauer <nas@arctrix.com>
Date: Sat, 6 Jun 2026 10:49:35 -0700
Subject: [PATCH] Fall back to native sampler when flashinfer is not installed

v0.22.1 flipped VLLM_USE_FLASHINFER_SAMPLER from opt-in (None) to
default-on (True). On CUDA with the env var unset, TopKTopPSampler now
runs `from vllm.v1.attention.backends.flashinfer import FlashInferBackend`
unconditionally. That import has no exception handling, so on a build
without the optional `flashinfer` package it raises ModuleNotFoundError
and kills EngineCore at startup.

Wrap the import in try/except ImportError. When flashinfer is absent and
the user did not explicitly opt in, fall back to the PyTorch-native
sampler (mirroring the existing "GPU too old" fallback). If the user
explicitly set VLLM_USE_FLASHINFER_SAMPLER=1, raise a clear error instead
of silently degrading.

Assisted-by: Claude
---
 vllm/v1/sample/ops/topk_topp_sampler.py | 66 ++++++++++++++++---------
 1 file changed, 43 insertions(+), 23 deletions(-)

diff --git a/vllm/v1/sample/ops/topk_topp_sampler.py b/vllm/v1/sample/ops/topk_topp_sampler.py
index f07fa17a9..098ae63ad 100644
--- a/vllm/v1/sample/ops/topk_topp_sampler.py
+++ b/vllm/v1/sample/ops/topk_topp_sampler.py
@@ -37,34 +37,54 @@ class TopKTopPSampler(nn.Module):
             and current_platform.is_cuda()
         ):
             if envs.VLLM_USE_FLASHINFER_SAMPLER:
-                from vllm.v1.attention.backends.flashinfer import FlashInferBackend
-
-                capability = current_platform.get_device_capability()
-                assert capability is not None
-                if FlashInferBackend.supports_compute_capability(capability):
-                    logger.info_once(
-                        "Using FlashInfer for top-p & top-k sampling.",
-                        scope="global",
+                try:
+                    from vllm.v1.attention.backends.flashinfer import (
+                        FlashInferBackend,
                     )
-                    self.forward = self.forward_cuda
-                elif envs.is_set("VLLM_USE_FLASHINFER_SAMPLER"):
-                    # User explicitly opted in but the GPU can't run FlashInfer.
-                    capability_str = capability.as_version_str()
-                    raise RuntimeError(
-                        "FlashInfer does not support compute capability "
-                        f"{capability_str}, unset VLLM_USE_FLASHINFER_SAMPLER=1."
-                    )
-                else:
-                    # Default-on path; hardware can't run FlashInfer →
+                except ImportError:
+                    if envs.is_set("VLLM_USE_FLASHINFER_SAMPLER"):
+                        # User explicitly opted in but flashinfer isn't installed.
+                        raise RuntimeError(
+                            "VLLM_USE_FLASHINFER_SAMPLER=1 was set but the "
+                            "'flashinfer' package is not installed; install it "
+                            "or unset VLLM_USE_FLASHINFER_SAMPLER."
+                        ) from None
+                    # Default-on path; flashinfer isn't installed →
                     # quietly fall back to the PyTorch-native sampler
-                    # instead of failing server startup.
+                    # instead of failing engine startup.
                     logger.warning_once(
-                        "FlashInfer top-p/top-k sampling not supported on "
-                        "compute capability %s; falling back to PyTorch-native "
-                        "sampler. Set VLLM_USE_FLASHINFER_SAMPLER=0 to silence.",
-                        capability.as_version_str(),
+                        "FlashInfer is not installed; falling back to the "
+                        "PyTorch-native top-p/top-k sampler. Set "
+                        "VLLM_USE_FLASHINFER_SAMPLER=0 to silence."
                     )
                     self.forward = self.forward_native
+                else:
+                    capability = current_platform.get_device_capability()
+                    assert capability is not None
+                    if FlashInferBackend.supports_compute_capability(capability):
+                        logger.info_once(
+                            "Using FlashInfer for top-p & top-k sampling.",
+                            scope="global",
+                        )
+                        self.forward = self.forward_cuda
+                    elif envs.is_set("VLLM_USE_FLASHINFER_SAMPLER"):
+                        # User explicitly opted in but the GPU can't run FlashInfer.
+                        capability_str = capability.as_version_str()
+                        raise RuntimeError(
+                            "FlashInfer does not support compute capability "
+                            f"{capability_str}, unset VLLM_USE_FLASHINFER_SAMPLER=1."
+                        )
+                    else:
+                        # Default-on path; hardware can't run FlashInfer →
+                        # quietly fall back to the PyTorch-native sampler
+                        # instead of failing server startup.
+                        logger.warning_once(
+                            "FlashInfer top-p/top-k sampling not supported on "
+                            "compute capability %s; falling back to PyTorch-native "
+                            "sampler. Set VLLM_USE_FLASHINFER_SAMPLER=0 to silence.",
+                            capability.as_version_str(),
+                        )
+                        self.forward = self.forward_native
             else:
                 # User explicitly set VLLM_USE_FLASHINFER_SAMPLER=0.
                 logger.info_once(
