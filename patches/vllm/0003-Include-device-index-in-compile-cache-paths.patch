From f7f067d5ad8f35bf88432d50b3e6f091ab5942c9 Mon Sep 17 00:00:00 2001
From: Neil Schemenauer <nas@arctrix.com>
Date: Mon, 6 Apr 2026 22:22:26 +0000
Subject: [PATCH 3/3] Include device index in compile cache paths

The inductor and AOT compile cache paths use rank and data-parallel
index but not the CUDA device index.  When multiple engines run on
different devices within a single process (e.g. multi-engine threaded
inference), they share the same cache directory and one engine may load
compiled artifacts from another device.  Inductor-generated code
contains device-specific stream references (via get_raw_stream), so
loading cached code compiled for cuda:0 on cuda:1 causes
"CUDA driver error: invalid argument".

Append the current accelerator device index to the cache path so each
device gets its own compiled artifacts.  This covers both vLLM's
rank_{rank}_{dp} artifact directory / AOT path and the Torch-Inductor
on-disk cache (TORCHINDUCTOR_CACHE_DIR), which upstream now derives from
the shared hash-level dir.  For the common single-device case the paths
simply gain a "_dev0" suffix with no behavioral change.

Signed-off-by: Neil Schemenauer <nas@arctrix.com>
Assisted-by: Claude
---
 vllm/compilation/backends.py   | 4 +++-
 vllm/compilation/decorators.py | 6 ++++--
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/vllm/compilation/backends.py b/vllm/compilation/backends.py
index 5a67415f1..251b4c635 100644
--- a/vllm/compilation/backends.py
+++ b/vllm/compilation/backends.py
@@ -1069,7 +1069,9 @@ class VllmBackend:
         self.compilation_config.cache_dir = cache_dir
         rank = vllm_config.parallel_config.rank
         dp_rank = vllm_config.parallel_config.data_parallel_index
-        local_cache_dir = os.path.join(cache_dir, f"rank_{rank}_{dp_rank}", self.prefix)
+        dev = torch.accelerator.current_device_index()
+        local_cache_dir = os.path.join(
+            cache_dir, f"rank_{rank}_{dp_rank}_dev{dev}", self.prefix)
         os.makedirs(local_cache_dir, exist_ok=True)
         self.compilation_config.local_cache_dir = local_cache_dir
 
diff --git a/vllm/compilation/decorators.py b/vllm/compilation/decorators.py
index ad710a6fe..f1dbde566 100644
--- a/vllm/compilation/decorators.py
+++ b/vllm/compilation/decorators.py
@@ -549,7 +549,8 @@ def _support_torch_compile(
 
             # Hash-level dir; shared across ranks on the same node.
             self.compilation_config.local_cache_dir = cache_dir
-            inductor_cache = os.path.join(cache_dir, "inductor_cache")
+            dev = torch.accelerator.current_device_index()
+            inductor_cache = os.path.join(cache_dir, f"inductor_cache_dev{dev}")
             os.makedirs(inductor_cache, exist_ok=True)
             # Process-wide: post-load execution, CUDA-graph capture, and later
             # autotune/recompile all need to write under {hash}/inductor_cache/.
@@ -559,7 +560,8 @@ def _support_torch_compile(
 
             rank = self.vllm_config.parallel_config.rank
             dp_rank = self.vllm_config.parallel_config.data_parallel_index
-            cache_dir = os.path.join(cache_dir, f"rank_{rank}_{dp_rank}")
+            cache_dir = os.path.join(cache_dir,
+                                     f"rank_{rank}_{dp_rank}_dev{dev}")
             aot_compilation_path = os.path.join(cache_dir, "model")
             if not envs.VLLM_DISABLE_COMPILE_CACHE:
                 loaded_fn = _try_load_aot_compiled_fn(self, aot_compilation_path)
