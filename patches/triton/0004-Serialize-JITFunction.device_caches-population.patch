From 9feaf9c6eb89b8573c3c919bb0c750291cabbf6f Mon Sep 17 00:00:00 2001
From: Neil Schemenauer <nas@arctrix.com>
Date: Fri, 28 Aug 2026 02:08:34 +0000
Subject: [PATCH 04/12] Serialize JITFunction.device_caches population

defaultdict(self.create_binder) races: two threads compiling the same
kernel for the same device can both miss and build separate binder
tuples, so one thread's compiled-kernel cache is silently discarded.

Replace it with a plain dict plus a lock and a double-checked
_get_device_cache() accessor, and add __getstate__/__setstate__ so the
lock and the live per-process caches are dropped when torch.compile
pickles a JITFunction into the Inductor static-autotuner cache.

Signed-off-by: Neil Schemenauer <nas@arctrix.com>
---
 python/test/unit/runtime/test_cache.py |  6 ++--
 python/triton/runtime/jit.py           | 38 ++++++++++++++++++++++----
 2 files changed, 36 insertions(+), 8 deletions(-)

diff --git a/python/test/unit/runtime/test_cache.py b/python/test/unit/runtime/test_cache.py
index a5c66382a..be25bdeec 100644
--- a/python/test/unit/runtime/test_cache.py
+++ b/python/test/unit/runtime/test_cache.py
@@ -471,7 +471,7 @@ def test_jit_warmup_cache(device) -> None:
         32,
     ]
     device = getattr(torch, device).current_device()
-    assert len(kernel_add.device_caches[device][0]) == 0
+    assert len(kernel_add._get_device_cache(device)[0]) == 0
     kernel_add.warmup(torch.float32, torch.float32, torch.float32, 32, grid=(1, ))
     assert len(kernel_add.device_caches[device][0]) == 1
     kernel_add.warmup(*args, grid=(1, ))
@@ -488,7 +488,7 @@ def test_jit_debug(device) -> None:
 
     device = getattr(torch, device).current_device()
     tmp = torch.tensor([1], dtype=torch.int32, device=device)
-    assert len(kernel.device_caches[device][0]) == 0
+    assert len(kernel._get_device_cache(device)[0]) == 0
     kernel[(1, )](tmp, debug=False)
     assert len(kernel.device_caches[device][0]) == 1
     kernel[(1, )](tmp, debug=True)
@@ -510,7 +510,7 @@ def test_jit_noinline(device) -> None:
         add_fn(a, b, o, N)
 
     device = getattr(torch, device).current_device()
-    assert len(kernel_add_device.device_caches[device][0]) == 0
+    assert len(kernel_add_device._get_device_cache(device)[0]) == 0
     kernel_add_device.warmup(torch.float32, torch.float32, torch.float32, 32, grid=(1, ))
     assert len(kernel_add_device.device_caches[device][0]) == 1
     bins = list(kernel_add_device.device_caches[device][0].values())
diff --git a/python/triton/runtime/jit.py b/python/triton/runtime/jit.py
index ba21a58e1..36777d241 100644
--- a/python/triton/runtime/jit.py
+++ b/python/triton/runtime/jit.py
@@ -7,7 +7,6 @@ import itertools
 import threading
 import re
 import textwrap
-from collections import defaultdict
 from dataclasses import dataclass
 from functools import cached_property
 from typing import Callable, Generic, Iterable, Optional, TypeVar, overload, Dict, Any, Tuple
@@ -681,6 +680,17 @@ class JITFunction(JITCallable, KernelInterface[T]):
         binder = create_function_from_signature(self.signature, self.params, backend)
         return {}, {}, target, backend, binder
 
+    def _get_device_cache(self, device):
+        entry = self.device_caches.get(device)
+        if entry is not None:
+            return entry
+        with self._device_caches_lock:
+            entry = self.device_caches.get(device)
+            if entry is None:
+                entry = self.create_binder()
+                self.device_caches[device] = entry
+            return entry
+
     def _pack_args(self, backend, kwargs, bound_args, specialization, options):
         # options
         options = backend.parse_options(kwargs)
@@ -717,7 +727,7 @@ class JITFunction(JITCallable, KernelInterface[T]):
         for hook in self.pre_run_hooks:
             hook(*args, **kwargs)
 
-        kernel_cache, kernel_key_cache, target, backend, binder = self.device_caches[device]
+        kernel_cache, kernel_key_cache, target, backend, binder = self._get_device_cache(device)
         # specialization is list[tuple[str, Any]], where first element of tuple is
         # the type and the second parameter is the 'specialization' value.
         bound_args, specialization, options = binder(*args, **kwargs)
@@ -787,7 +797,8 @@ class JITFunction(JITCallable, KernelInterface[T]):
             self.params.append(KernelParam(i, param, dns, dns_oa))
 
         # cache of just-in-time compiled kernels
-        self.device_caches = defaultdict(self.create_binder)
+        self.device_caches = {}
+        self._device_caches_lock = threading.Lock()
 
         # JITFunction can be instantiated as kernel
         # when called with a grid using __getitem__
@@ -803,6 +814,23 @@ class JITFunction(JITCallable, KernelInterface[T]):
         # Hooks that will be called prior to executing "run"
         self.pre_run_hooks = []
 
+    def __getstate__(self):
+        # JITFunction is pickled into torch.compile's (possibly cross-process)
+        # Inductor static-autotuner cache. _device_caches_lock is not picklable,
+        # and device_caches holds live per-process compiled state (binders,
+        # compiled kernels) that must not be serialized. Drop both here;
+        # __setstate__ rebuilds them. (The upstream _hash_lock is stripped
+        # separately by torch's CachingAutotuner.prepare_for_pickle.)
+        state = self.__dict__.copy()
+        state["_device_caches_lock"] = None
+        state["device_caches"] = {}
+        return state
+
+    def __setstate__(self, state):
+        self.__dict__.update(state)
+        self._device_caches_lock = threading.Lock()
+        self.device_caches = {}
+
     def preload(self, specialization_data):
         import json
         import triton.language as tl
@@ -813,7 +841,7 @@ class JITFunction(JITCallable, KernelInterface[T]):
                 f"Specialization data is for {deserialized_obj['name']} but trying to preload for {self._fn_name}")
         constant_keys = map(tuple, deserialized_obj['constant_keys'])
         constant_vals = deserialized_obj['constant_vals']
-        _, _, target, backend, _ = self.device_caches[device]
+        _, _, target, backend, _ = self._get_device_cache(device)
         deserialized_target = deserialized_obj['target']
         # TODO: we could support loading a kernel signature serialized on a different target however
         # currently options are target specific so we would need to change that.
@@ -857,7 +885,7 @@ class JITFunction(JITCallable, KernelInterface[T]):
         )
 
     def _do_compile(self, key, signature, device, constexprs, options, attrs, warmup):
-        kernel_cache, _, target, backend, _ = self.device_caches[device]
+        kernel_cache, _, target, backend, _ = self._get_device_cache(device)
 
         if self._call_hook(knobs.runtime.jit_cache_hook, key, signature, target, device, constexprs, options, [attrs],
                            warmup):
