From a517fed098f4eb37e61cc3184a21878a6b737461 Mon Sep 17 00:00:00 2001
From: Neil Schemenauer <nas@arctrix.com>
Date: Sat, 30 May 2026 08:11:15 -0700
Subject: [PATCH 01/12] Use std::call_once for init_globals() serialization in
 specialize.cc

Under free-threaded CPython, two threads can both observe the plain
init_called guard as false and enter init_globals() concurrently. That
races on the file-scope PyObject* assignments and on the
unordered_map-backed type_handler_cache population.

Assisted-by: claude-sonnet-4-6
---
 python/src/specialize.cc | 21 +++++++++++++++------
 1 file changed, 15 insertions(+), 6 deletions(-)

diff --git a/python/src/specialize.cc b/python/src/specialize.cc
index 3449e3c90..374eba307 100644
--- a/python/src/specialize.cc
+++ b/python/src/specialize.cc
@@ -3,6 +3,7 @@
 #include <cstdint>
 #include <cstdlib>
 #include <functional>
+#include <mutex>
 #include <pybind11/pybind11.h>
 #include <string>
 #include <unordered_map>
@@ -34,7 +35,8 @@ static std::pair<py::object, py::object>
 specialize_arg(PyObject *backend, PyObject *arg, bool is_const,
                bool specialize_value, bool align);
 
-static bool init_called = false;
+static std::once_flag init_flag;
+static bool init_success = false;
 
 static PyObject *constexpr_cls = nullptr;
 static PyObject *jit_callable_cls = nullptr;
@@ -143,13 +145,22 @@ bool init_globals() noexcept try {
   init_interned_strings();
   init_type_handler_cache();
 
-  init_called = true;
   return true;
 } catch (py::error_already_set &e) {
   e.restore();
   return false;
 }
 
+// NOTE: std::call_once does not support re-entrant calls from within the
+// callable. If init_globals() triggers a Python import that re-enters
+// native_specialize_impl on the same thread, behavior is undefined. In
+// practice this should not occur since triton.runtime.jit is already loaded
+// before specialize is first called.
+bool ensure_init() {
+  std::call_once(init_flag, []() { init_success = init_globals(); });
+  return init_success;
+}
+
 std::pair<py::object, py::object> specialize_tensordesc(PyObject *arg,
                                                         bool has_layout) {
   auto base = from_new_ref(PyObject_GetAttr(arg, base_attr));
@@ -531,10 +542,8 @@ std::pair<py::object, py::object> specialize_arg(PyObject *backend,
 // main entry-point from Python implementing specialization logic natively
 PyObject *specialize_impl(PyObject *self, PyObject *const *args,
                           Py_ssize_t nargs) {
-  if (!init_called) {
-    if (!init_globals()) {
-      return nullptr;
-    }
+  if (!ensure_init()) {
+    return nullptr;
   }
 
   if (nargs != 5) {
